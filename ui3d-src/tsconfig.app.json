{
    "compilerOptions": {
        "target": "ES2022",
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["ES2022", "DOM"],
        "outDir": "./out-tsc"
    },
    "angularCompilerOptions": {"strictTemplates": true, "strictInjectionParameters": true},
    "files": ["src/main.ts"],
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts"]
}
